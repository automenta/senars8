import React from 'react';
import {fireEvent, render, screen, waitFor} from '@testing-library/react';
import userEvent from '@testing-library/user-event';
import App from '../App';
import agentService from '../services/agentService';
import agentIntegrationService from '../services/agentIntegration';
import notificationService from '../services/notificationService';
import { ThemeProvider } from '../context/ThemeProvider';
import { SettingsProvider } from '../context/SettingsProvider';
import { ConnectionProvider } from '../context/ConnectionProvider';
import { SharedStateProvider } from '../context/SharedStateProvider';
import { NotificationProvider } from '../context/NotificationContext';
import { SearchProvider } from '../context/SearchContext';
import { TaskProvider } from '../context/TaskContext';
import { SessionProvider } from '../context/SessionContext';

// Mock all services
jest.mock('@/services/agentService', () => ({
    on: jest.fn(),
    off: jest.fn(),
    connect: jest.fn(),
    disconnect: jest.fn(),
    sendMessage: jest.fn(),
    sendNarsese: jest.fn(),
    sendNaturalLanguage: jest.fn(),
    isConnected: true,
    isAgentRunning: jest.fn(),
    getBeliefsCount: jest.fn(),
    getGoalsCount: jest.fn(),
    getQuestionsCount: jest.fn(),
    getCycleCount: jest.fn(),
    getTasks: jest.fn(),
}));

jest.mock('@/services/agentIntegration', () => ({
    initialize: jest.fn(() => Promise.resolve()),
    processNarsese: jest.fn(),
    getAgentInfo: jest.fn(),
    sendAgentCommand: jest.fn(),
    getAllTasks: jest.fn(),
    getInitializedStatus: jest.fn(() => true),
}));

const mockNotifications = [];
jest.mock('@/services/notificationService', () => ({
    addInfo: jest.fn(),
    addError: jest.fn(),
    addWarning: jest.fn(),
    addSuccess: jest.fn(),
    getNotifications: jest.fn(() => mockNotifications),
    on: jest.fn(),
    off: jest.fn(),
}));

// Stable mock values for hooks to prevent re-renders
const mockUseConnection = {
    isConnected: true,
    connectionStatus: 'connected',
    connectionError: null,
    reconnect: jest.fn(),
};
const mockUseSettings = {
    isSonificationEnabled: false,
};
const mockUseInputHistory = {
    inputValue: '',
    setInputValue: jest.fn(),
    history: [],
    addToHistory: jest.fn(),
};
const mockUseReasoningDebugger = {
    debugResults: null,
    isProcessing: false,
    debugReasoning: jest.fn(),
    clearDebugResults: jest.fn(),
};
const mockAgentState = {
    isInitialized: true,
    isActive: true,
    beliefsCount: 5,
    goalsCount: 2,
    questionsCount: 1,
    timestamp: 1234567890, // Fixed timestamp
};

jest.mock('@/context/useConnection', () => ({
    useConnection: () => mockUseConnection,
}));

jest.mock('@/context/useSettings', () => ({
    useSettings: () => mockUseSettings,
}));

jest.mock('@/hooks/useInputHistory', () => () => mockUseInputHistory);

import {Model} from 'flexlayout-react';
import defaultLayout from '@/features/defaultLayout';

const mockModel = Model.fromJson(defaultLayout);

jest.mock('@/hooks/useLayoutModel', () => ({
    __esModule: true,
    default: () => ({
        model: mockModel,
        onModelChange: jest.fn(),
    }),
}));

jest.mock('@/hooks/useReasoningDebugger', () => () => mockUseReasoningDebugger);

// Mock the core integration utilities
jest.mock('@/utils/coreIntegration', () => ({
    formatCoreDataForUI: jest.fn((data) => data),
    validateNarseseStatement: jest.fn((statement) => ({
        valid: !!statement,
        error: !statement ? 'Statement cannot be empty' : null,
    })),
    createTaskFromStatement: jest.fn(),
    getAgentStateForUI: jest.fn(() => mockAgentState),
    processNarseseThroughAgent: jest.fn(),
}));

// Mock XTerm
jest.mock('react-xtermjs', () => ({
    XTerm: () => null,
}));

jest.mock('flexlayout-react', () => {
    const original = jest.requireActual('flexlayout-react');
    const React = require('react');
    return {
        ...original,
        Layout: ({ factory, model }) => {
            const components = [];
            model.visitNodes((node) => {
                if (node.getType() === 'tab') {
                    components.push(React.createElement(factory(node), { key: node.getId() }));
                }
            });
            return React.createElement('div', { 'data-testid': 'mock-layout' }, components);
        },
    };
});

// Helper function to render with all providers
const renderWithProviders = (ui, options) => {
    const AllTheProviders = ({children}) => (
        <ThemeProvider>
            <SettingsProvider>
                <ConnectionProvider>
                    <SharedStateProvider>
                        <NotificationProvider>
                            <SearchProvider>
                                <TaskProvider>
                                    <SessionProvider>{children}</SessionProvider>
                                </TaskProvider>
                            </SearchProvider>
                        </NotificationProvider>
                    </SharedStateProvider>
                </ConnectionProvider>
            </SettingsProvider>
        </ThemeProvider>
    );
    return render(ui, {wrapper: AllTheProviders, ...options});
};


describe('UI-Agent-Core Integration Tests', () => {
    beforeEach(() => {
        jest.clearAllMocks();

        // Default mock returns
        agentService.isAgentRunning.mockReturnValue(true);
        agentService.getBeliefsCount.mockReturnValue(5);
        agentService.getGoalsCount.mockReturnValue(2);
        agentService.getQuestionsCount.mockReturnValue(1);
        agentService.getCycleCount.mockReturnValue(100);
        agentIntegrationService.getAgentInfo.mockReturnValue({
            isInitialized: true,
            isActive: true,
            beliefsCount: 5,
            goalsCount: 2,
            questionsCount: 1,
            cycleCount: 100,
            timestamp: Date.now(),
        });
    });

    describe('Status Panel Integration', () => {
        test('displays agent information correctly', () => {
            renderWithProviders(<App/>);

            // Check if status panel shows agent info
            expect(screen.getByText(/Connected/)).toBeInTheDocument();
            expect(screen.getByText(/Cycle: 100/)).toBeInTheDocument();
            expect(screen.getByText(/Beliefs: 5/)).toBeInTheDocument();
            expect(screen.getByText(/Goals: 2/)).toBeInTheDocument();
            expect(screen.getByText(/Questions: 1/)).toBeInTheDocument();
            expect(screen.getByText(/AI: Ready/)).toBeInTheDocument();
        });

        test('handles agent statistics updates', async () => {
            // Simulate event emission for stats update
            const handleStatsUpdate = jest.fn();
            agentService.on.mockImplementation((event, handler) => {
                if (event === 'system_stats' || event === 'system_cycle') {
                    handleStatsUpdate(handler);
                }
            });

            renderWithProviders(<App/>);

            // Verify event listeners are registered
            expect(agentService.on).toHaveBeenCalledWith('system_stats', expect.any(Function));
            expect(agentService.on).toHaveBeenCalledWith('system_cycle', expect.any(Function));
        });
    });

    describe('Control Panel Integration', () => {
        test('sends start command to agent', async () => {
            agentIntegrationService.sendAgentCommand.mockResolvedValue(true);

            renderWithProviders(<App/>);

            // Find and click the start button (this requires identifying the control panel)
            const startButton = screen.getByRole('button', {name: /Start/});
            fireEvent.click(startButton);

            await waitFor(() => {
                expect(agentIntegrationService.sendAgentCommand).toHaveBeenCalledWith('start');
                expect(notificationService.addInfo).toHaveBeenCalledWith(
                    'Agent Control',
                    'Start command sent to agent'
                );
            });
        });

        test('sends stop command to agent', async () => {
            agentIntegrationService.sendAgentCommand.mockResolvedValue(true);

            renderWithProviders(<App/>);

            const stopButton = screen.getByRole('button', {name: /Stop/});
            fireEvent.click(stopButton);

            await waitFor(() => {
                expect(agentIntegrationService.sendAgentCommand).toHaveBeenCalledWith('stop');
            });
        });

        test('sends reset command to agent', async () => {
            agentIntegrationService.sendAgentCommand.mockResolvedValue(true);

            renderWithProviders(<App/>);

            const resetButton = screen.getByRole('button', {name: /Reset/});
            fireEvent.click(resetButton);

            await waitFor(() => {
                expect(agentIntegrationService.sendAgentCommand).toHaveBeenCalledWith('reset');
                expect(notificationService.addWarning).toHaveBeenCalledWith(
                    'Agent Control',
                    'Reset command sent to agent - all memory cleared'
                );
            });
        });
    });

    describe('Input Panel Integration', () => {
        test('sends narsese statement to agent', async () => {
            agentService.sendNarsese.mockReturnValue(true);

            renderWithProviders(<App/>);

            const input = screen.getByRole('textbox');
            fireEvent.change(input, {target: {value: '<bird --> animal>.'}});

            const sendButton = screen.getByRole('button', {name: /Send/});
            fireEvent.click(sendButton);

            await waitFor(() => {
                expect(agentService.sendNarsese).toHaveBeenCalledWith('<bird --> animal>.');
                expect(notificationService.addSuccess).toHaveBeenCalledWith(
                    'Narsese Sent',
                    'Statement: <bird --> animal>.',
                    3000
                );
            });
        });

        test('sends natural language to agent', async () => {
            agentService.sendNaturalLanguage.mockReturnValue(true);

            renderWithProviders(<App/>);

            const input = screen.getByRole('textbox');
            fireEvent.change(input, {target: {value: 'Tell me about birds'}});

            const sendButton = screen.getByRole('button', {name: /Send/});
            fireEvent.click(sendButton);

            await waitFor(() => {
                expect(agentService.sendNaturalLanguage).toHaveBeenCalledWith('Tell me about birds');
                expect(notificationService.addInfo).toHaveBeenCalledWith(
                    'NL Sent',
                    'Input: Tell me about birds',
                    3000
                );
            });
        });

        test('validates narsese input before sending', async () => {
            const user = userEvent.setup();
            const {validateNarseseStatement} = jest.requireMock('@/utils/coreIntegration');
            validateNarseseStatement.mockReturnValue({valid: false, error: 'Invalid Narsese'});

            renderWithProviders(<App/>);

            const input = screen.getByRole('textbox');
            // This needs to look like a narsese statement to trigger validation
            await user.type(input, 'invalid.');

            const sendButton = screen.getByRole('button', {name: /Send/});
            await user.click(sendButton);

            await waitFor(() => {
                expect(notificationService.addWarning).toHaveBeenCalledWith(
                    'Invalid Narsese',
                    'Invalid Narsese'
                );
            });
        });
    });

    describe('Task Inspector Integration', () => {
        test('fetches and displays tasks from agent', async () => {
            agentIntegrationService.getAllTasks.mockReturnValue([
                {id: 'task1', statement: '<bird --> animal>.', punctuation: '.', priority: 0.8}
            ]);

            renderWithProviders(<App/>);

            // Wait for tasks to be fetched and displayed
            await waitFor(() => {
                expect(screen.getByText(/<bird --> animal>\./)).toBeInTheDocument();
            });
        });
    });

    describe('Reasoning Debugger Integration', () => {
        test('validates and debugs reasoning statements', async () => {
            const validateNarseseStatement = jest.requireMock('@/utils/coreIntegration').validateNarseseStatement;
            validateNarseseStatement.mockReturnValue({valid: true, parsed: {}});

            renderWithProviders(<App/>);

            const input = screen.getByRole('textbox', {name: /Narsese Statement/});
            fireEvent.change(input, {target: {value: '<bird --> animal>.'}});

            const debugButton = screen.getByRole('button', {name: /Debug/});
            fireEvent.click(debugButton);

            await waitFor(() => {
                expect(validateNarseseStatement).toHaveBeenCalledWith('<bird --> animal>.');
            });
        });
    });

    describe('Error Handling Integration', () => {
        test('handles agent service errors gracefully', async () => {
            agentIntegrationService.processNarsese.mockRejectedValue(new Error('Agent error'));

            renderWithProviders(<App/>);

            const input = screen.getByRole('textbox');
            fireEvent.change(input, {target: {value: '<bird --> animal>.'}});

            const sendButton = screen.getByRole('button', {name: /Send/});
            fireEvent.click(sendButton);

            await waitFor(() => {
                expect(notificationService.addError).toHaveBeenCalledWith(
                    'Send Error',
                    'Failed to send message to agent'
                );
            });
        });
    });

    describe('Connection Handling', () => {
        test('displays connection status properly', () => {
            renderWithProviders(<App/>);

            expect(screen.getByText(/Connected/)).toBeInTheDocument();
        });

        test('handles disconnection scenarios', () => {
            // Mock disconnected state
            jest.mock('@/context/useConnection', () => ({
                useConnection: () => ({
                    isConnected: false,
                    connectionStatus: 'disconnected',
                    connectionError: null,
                    reconnect: jest.fn(),
                }),
            }));

            renderWithProviders(<App/>);

            expect(screen.getByText(/Disconnected/)).toBeInTheDocument();
        });
    });
});