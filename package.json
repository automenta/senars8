{
  "name": "senars",
  "version": "1.1.0",
  "description": "A modular and extensible neuro-symbolic cognitive architecture, combining formal reasoning with large language models.",
  "main": "core/index.js",
  "module": "core/index.js",
  "private": true,
  "workspaces": [
    "core",
    "agent",
    "ui",
    "tui"
  ],
  "files": [
    "core/",
    "agent/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node agent/server.js",
    "dev": "concurrently \"node agent/server.js\" \"npm run dev --prefix ui\"",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "lint": "eslint core agent tests",
    "lint:fix": "eslint core agent tests --fix",
    "slides": "slidev docs/slides.md"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/automenta/senars8.git"
  },
  "keywords": [
    "ai",
    "cognitive-architecture",
    "neuro-symbolic",
    "nars",
    "reasoning",
    "langchain",
    "agi",
    "cognitive-science",
    "inference"
  ],
  "author": "SeNARS Developers <jules@example.com>",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "bugs": {
    "url": "https://github.com/automenta/senars8/issues"
  },
  "homepage": "https://github.com/automenta/senars8#readme",
  "dependencies": {
    "@datastructures-js/priority-queue": "^6.3.4",
    "@langchain/community": "^0.3.56",
    "@langchain/core": "^0.3.77",
    "@xenova/transformers": "^2.17.2",
    "chalk": "^5.6.2",
    "express": "^5.1.0",
    "langchain": "^0.3.34",
    "moo": "^0.5.2",
    "ollama": "^0.5.18",
    "uuid": "^13.0.0",
    "ws": "^8.18.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@slidev/cli": "^52.1.0",
    "@slidev/theme-default": "^0.25.0",
    "@vitest/ui": "^2.0.5",
    "blessed": "^0.1.81",
    "concurrently": "^9.2.1",
    "eslint": "^9.35.0",
    "eslint-plugin-promise": "^7.2.1",
    "jsdom": "^25.0.1",
    "slidev-theme-dracula": "^0.2.0",
    "vitest": "^2.0.5"
  }
}
