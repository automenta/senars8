{
  "name": "senars",
  "version": "1.1.0",
  "description": "A modular and extensible neuro-symbolic cognitive architecture, combining formal reasoning with large language models.",
  "main": "core/index.js",
  "module": "core/index.js",
  "private": true,
  "workspaces": [
    "core",
    "agent",
    "tui",
    "ui",
    "common"
  ],
  "files": [
    "core/",
    "agent/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node main.js",
    "dev": "node main.js --web",
    "dev:ws": "WS_PORT=8081 node main.js --web",
    "tui": "tsx tui/src/index.jsx",
    "agent:ws": "WS_PORT=8081 node agent/start-agent.js",
    "test": "ORT_LOGGING_LEVEL=FATAL vitest --run",
    "test:ui": "ORT_LOGGING_LEVEL=FATAL vitest --ui",
    "test:tui": "ORT_LOGGING_LEVEL=FATAL vitest --run tui/tests/",
    "test:tui:integration": "node tui/tests/run-integration-tests.js",
    "test:core": "CI=true ORT_LOGGING_LEVEL=FATAL vitest run --project core",
    "test:watch": "ORT_LOGGING_LEVEL=FATAL vitest --watch --reporter=verbose",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "slides": "slidev docs/slides.md"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/automenta/senars8.git"
  },
  "keywords": [
    "ai",
    "cognitive-architecture",
    "neuro-symbolic",
    "nars",
    "reasoning",
    "langchain",
    "agi",
    "cognitive-science",
    "inference"
  ],
  "author": "SeNARS Developers <jules@example.com>",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "bugs": {
    "url": "https://github.com/automenta/senars8/issues"
  },
  "homepage": "https://github.com/automenta/senars8#readme",
  "dependencies": {
    "@datastructures-js/priority-queue": "^6.3.4",
    "@langchain/community": "^0.3.56",
    "@langchain/core": "^0.3.77",
    "@xenova/transformers": "^2.17.2",
    "chalk": "^5.6.2",
    "chokidar": "^3.6.0",
    "execa": "^9.6.0",
    "express": "^5.1.0",
    "glob": "^10.4.5",
    "ink": "^4.4.1",
    "langchain": "^0.3.34",
    "lodash": "^4.17.21",
    "moo": "^0.5.2",
    "ollama": "^0.5.18",
    "react": "^18.3.1",
    "react-ace": "^14.0.1",
    "react-dom": "^18.3.1",
    "react-xtermjs": "^1.0.10",
    "uuid": "^13.0.0",
    "ws": "^8.18.3",
    "yaml": "^2.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@slidev/cli": "^52.1.0",
    "@slidev/theme-default": "^0.25.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@vitejs/plugin-react": "^5.0.3",
    "@vitest/ui": "^2.0.5",
    "cross-env": "^10.1.0",
    "eslint": "^9.35.0",
    "eslint-plugin-promise": "^7.2.1",
    "jsdom": "^25.0.1",
    "playwright": "^1.49.0",
    "slidev-theme-dracula": "^0.2.0",
    "tsx": "^4.20.6",
    "vite": "^5.1.7",
    "vitest": "^2.0.5"
  }
}