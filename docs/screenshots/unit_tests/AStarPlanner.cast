[0.004254, "o", " \u001b[90m·\u001b[39m \u001b[2mtests/integration/\u001b[22mAStarPlanner\u001b[2m.test.js\u001b[22m\u001b[2m (8)\u001b[22m\r\n   \u001b[90m·\u001b[39m AStarPlanner Integration Test\u001b[2m (8)\u001b[22m\r\n     \u001b[90m·\u001b[39m should find the cheapest plan, even if it is longer\r\n     \u001b[90m·\u001b[39m should find a simple plan with one level of decomposition\r\n     \u001b[90m·\u001b[39m should return a plan with a single primitive action\r\n     \u001b[90m·\u001b[39m should find the optimal (cheapest) plan when two paths exist\r\n     \u001b[90m·\u001b[39m should return an empty plan if the goal is already achieved\r\n     \u001b[90m·\u001b[39m should handle multi-level decomposition\r\n     \u001b[90m·\u001b[39m should handle cyclic dependencies and not get stuck in a loop\r\n     \u001b[90m·\u001b[39m should not use a path if preconditions are not met\r\n"]
