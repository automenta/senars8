[0.000012, "o", "\u001b[90m2025-10-04T13:57:06.115Z\u001b[39m \u001b[34mINFO \u001b[39m  1. (bird --> animal) - Birds are animals \r\n"]
[0.000029, "o", "\u001b[90m2025-10-04T13:57:06.115Z\u001b[39m \u001b[34mINFO \u001b[39m  2. (animal --> living) - Animals are living things \r\n"]
