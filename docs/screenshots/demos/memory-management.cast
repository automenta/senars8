[0.000378, "o", "\u001b[90m2025-10-04T13:57:04.390Z\u001b[39m \u001b[34mINFO \u001b[39m  \\n=== Memory Management Demonstration === \r\n"]
[0.000057, "o", "\u001b[90m2025-10-04T13:57:04.390Z\u001b[39m \u001b[34mINFO \u001b[39m  Memory Management Features: \r\n\u001b[90m2025-10-04T13:57:04.390Z\u001b[39m \u001b[34mINFO \u001b[39m  - Priority-based task selection \r\n"]
[0.000007, "o", "\u001b[90m2025-10-04T13:57:04.390Z\u001b[39m \u001b[34mINFO \u001b[39m  - Forgetting of low-priority items \r\n"]
[0.000058, "o", "\u001b[90m2025-10-04T13:57:04.390Z\u001b[39m \u001b[34mINFO \u001b[39m  - Dynamic allocation based on task importance \r\n\u001b[90m2025-10-04T13:57:04.390Z\u001b[39m \u001b[34mINFO \u001b[39m  - Concept formation from similar tasks \r\n"]
[0.000512, "o", "\u001b[90m2025-10-04T13:57:04.391Z\u001b[39m \u001b[34mINFO \u001b[39m  \\nTotal tasks in memory: 236 \r\n"]
[0.000024, "o", "\u001b[90m2025-10-04T13:57:04.391Z\u001b[39m \u001b[34mINFO \u001b[39m  High priority beliefs: 6 \r\n"]
[0.000003, "o", "\u001b[90m2025-10-04T13:57:04.391Z\u001b[39m \u001b[34mINFO \u001b[39m  \\nHigh Priority Items (should remain in memory): \r\n"]
[0.000082, "o", "\u001b[90m2025-10-04T13:57:04.391Z\u001b[39m \u001b[34mINFO \u001b[39m  - (important --> fact) (conf: 0.90, freq: 0.90) \r\n"]
[0.000025, "o", "\u001b[90m2025-10-04T13:57:04.391Z\u001b[39m \u001b[34mINFO \u001b[39m  - (crucial --> knowledge) (conf: 0.90, freq: 0.80) \r\n"]
[0.000039, "o", "\u001b[90m2025-10-04T13:57:04.391Z\u001b[39m \u001b[34mINFO \u001b[39m  - (knowledge --> crucial) (conf: 0.63, freq: 0.80) \r\n\u001b[90m2025-10-04T13:57:04.391Z\u001b[39m \u001b[34mINFO \u001b[39m  - ((--,fact) --> (--,important)) (conf: 0.90, freq: 0.90) \r\n"]
[0.000067, "o", "\u001b[90m2025-10-04T13:57:04.391Z\u001b[39m \u001b[34mINFO \u001b[39m  - ((--,knowledge) --> (--,crucial)) (conf: 0.90, freq: 0.80) \r\n"]
[0.000039, "o", "\u001b[90m2025-10-04T13:57:04.391Z\u001b[39m \u001b[34mINFO \u001b[39m  - (fact --> important) (conf: 0.63, freq: 0.90) \r\n"]
[0.000068, "o", "\u001b[90m2025-10-04T13:57:04.391Z\u001b[39m \u001b[34mINFO \u001b[39m  \\nLow priority items remaining: 0 (out of 20 added) \r\n"]
[0.00004, "o", "\u001b[90m2025-10-04T13:57:04.391Z\u001b[39m \u001b[34mINFO \u001b[39m  This demonstrates the forgetting mechanism - lower priority items are removed as memory fills. \r\n\u001b[90m2025-10-04T13:57:04.391Z\u001b[39m \u001b[34mINFO \u001b[39m  \\nMemory Management Strategies: \r\n"]
[0.000043, "o", "\u001b[90m2025-10-04T13:57:04.391Z\u001b[39m \u001b[34mINFO \u001b[39m  - Priority forgetting: Low-priority items are forgotten first \r\n\u001b[90m2025-10-04T13:57:04.391Z\u001b[39m \u001b[34mINFO \u001b[39m  - Activation-based retrieval: Recently used items are more accessible \r\n"]
[0.000038, "o", "\u001b[90m2025-10-04T13:57:04.391Z\u001b[39m \u001b[34mINFO \u001b[39m  - Concept consolidation: Similar tasks are merged into higher-level concepts \r\n"]
[0.000007, "o", "\u001b[90m2025-10-04T13:57:04.391Z\u001b[39m \u001b[34mINFO \u001b[39m  \\nMemory utilization: \r\n"]
[0.000025, "o", "\u001b[90m2025-10-04T13:57:04.391Z\u001b[39m \u001b[34mINFO \u001b[39m  - Memory store structure varies by system version \r\n"]
[0.000019, "o", "\u001b[90m2025-10-04T13:57:04.391Z\u001b[39m \u001b[34mINFO \u001b[39m  - Tasks processed: 236 \r\n"]
[0.00002, "o", "\u001b[90m2025-10-04T13:57:04.391Z\u001b[39m \u001b[34mINFO \u001b[39m  - High-value knowledge preserved: Yes \r\n"]
[0.000045, "o", "\r\n\u001b[1m\u001b[36m╔══════════════════════════════════════════════════════════════════════════════╗\u001b[0m\r\n"]
[0.000019, "o", "\u001b[1m\u001b[33m║                 ✅ Completed: Memory Management Demonstration                 ║          \u001b[0m\r\n"]
[0.000024, "o", "\u001b[1m\u001b[36m╚══════════════════════════════════════════════════════════════════════════════╝\u001b[0m\r\n\r\n"]
