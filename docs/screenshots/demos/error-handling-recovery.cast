[0.10167, "o", "\u001b[90m2025-10-04T13:57:01.114Z\u001b[39m \u001b[34mINFO \u001b[39m  \\n=== Error Handling and Recovery Demonstration === \r\n\u001b[90m2025-10-04T13:57:01.114Z\u001b[39m \u001b[34mINFO \u001b[39m  The system handles several types of inconsistencies: \r\n"]
[0.00007, "o", "\u001b[90m2025-10-04T13:57:01.114Z\u001b[39m \u001b[34mINFO \u001b[39m  1. Contradictions in beliefs \r\n\u001b[90m2025-10-04T13:57:01.114Z\u001b[39m \u001b[34mINFO \u001b[39m  2. Conflicting inheritance paths \r\n"]
[0.000044, "o", "\u001b[90m2025-10-04T13:57:01.114Z\u001b[39m \u001b[34mINFO \u001b[39m  3. Temporal inconsistencies \r\n"]
[0.000037, "o", "\u001b[90m2025-10-04T13:57:01.114Z\u001b[39m \u001b[34mINFO \u001b[39m  4. Resource limitations \r\n"]
[0.000005, "o", "\u001b[90m2025-10-04T13:57:01.114Z\u001b[39m \u001b[34mINFO \u001b[39m  \\nTest Case 1 - Bird/Penguin Contradiction: \r\n"]
[0.000043, "o", "\u001b[90m2025-10-04T13:57:01.114Z\u001b[39m \u001b[34mINFO \u001b[39m  - (bird --> flyer) [0.9, 0.9] \r\n"]
[0.000019, "o", "\u001b[90m2025-10-04T13:57:01.114Z\u001b[39m \u001b[34mINFO \u001b[39m  - (penguin --> bird) [1.0, 0.9] \r\n"]
[0.000095, "o", "\u001b[90m2025-10-04T13:57:01.114Z\u001b[39m \u001b[34mINFO \u001b[39m  - (penguin --> not_flyer) [0.8, 0.85] (contradicts with penguin inheriting flyer property) \r\n\u001b[90m2025-10-04T13:57:01.114Z\u001b[39m \u001b[34mINFO \u001b[39m  \\nTest Case 2 - Mammal/Fish/Whale Contradiction: \r\n\u001b[90m2025-10-04T13:57:01.114Z\u001b[39m \u001b[34mINFO \u001b[39m  - (mammal --> warm_blooded) [1.0, 0.95] \r\n"]
[0.000033, "o", "\u001b[90m2025-10-04T13:57:01.114Z\u001b[39m \u001b[34mINFO \u001b[39m  - (whale --> mammal) [1.0, 0.9] \r\n"]
[0.000027, "o", "\u001b[90m2025-10-04T13:57:01.114Z\u001b[39m \u001b[34mINFO \u001b[39m  - (whale --> fish) [0.6, 0.7] (conflict) \r\n"]
[0.000034, "o", "\u001b[90m2025-10-04T13:57:01.114Z\u001b[39m \u001b[34mINFO \u001b[39m  - (fish --> cold_blooded) [0.95, 0.9] (conflict with warm_blooded) \r\n"]
[0.000748, "o", "\u001b[90m2025-10-04T13:57:01.115Z\u001b[39m \u001b[34mINFO \u001b[39m  \\nTotal tasks processed: 82 \r\n"]
