[0.06326, "o", "\u001b[90m2025-10-04T13:57:02.796Z\u001b[39m \u001b[34mINFO \u001b[39m  \\n=== Goal Driven Behavior Demonstration === \r\n\u001b[90m2025-10-04T13:57:02.796Z\u001b[39m \u001b[34mINFO \u001b[39m  Scenario: An agent is hungry and needs to find food \r\n"]
[0.000011, "o", "\u001b[90m2025-10-04T13:57:02.796Z\u001b[39m \u001b[34mINFO \u001b[39m  \\nInitial State: \r\n"]
