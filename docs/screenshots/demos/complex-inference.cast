[0.073432, "o", "\u001b[90m2025-10-04T13:56:56.839Z\u001b[39m \u001b[34mINFO \u001b[39m  \\n=== Complex Inference with Multiple Derivations === \r\n\u001b[90m2025-10-04T13:56:56.839Z\u001b[39m \u001b[34mINFO \u001b[39m  Initial Knowledge: \r\n"]
[0.000076, "o", "\u001b[90m2025-10-04T13:56:56.839Z\u001b[39m \u001b[34mINFO \u001b[39m  1. (student --> person) - Students are people \r\n\u001b[90m2025-10-04T13:56:56.839Z\u001b[39m \u001b[34mINFO \u001b[39m  2. (person --> mortal) - People are mortal \r\n"]
[0.000239, "o", "\u001b[90m2025-10-04T13:56:56.839Z\u001b[39m \u001b[34mINFO \u001b[39m  3. (student --> learner) - Students are learners \r\n\u001b[90m2025-10-04T13:56:56.839Z\u001b[39m \u001b[34mINFO \u001b[39m  4. (learner --> knowledgeable) - Learners become knowledgeable \r\n\u001b[90m2025-10-04T13:56:56.839Z\u001b[39m \u001b[34mINFO \u001b[39m  5. (person --> agent) - People are agents \r\n\u001b[90m2025-10-04T13:56:56.839Z\u001b[39m \u001b[34mINFO \u001b[39m  6. (agent --> goal_directed) - Agents have goals \r\n\u001b[90m2025-10-04T13:56:56.839Z\u001b[39m \u001b[34mINFO \u001b[39m  7. john_student - John is a student \r\n\u001b[90m2025-10-04T13:56:56.839Z\u001b[39m \u001b[34mINFO \u001b[39m  \\nMultiple Inference Paths: \r\n"]
[0.000062, "o", "\u001b[90m2025-10-04T13:56:56.839Z\u001b[39m \u001b[34mINFO \u001b[39m  Path 1: john_student -> student -> person -> mortal \r\n\u001b[90m2025-10-04T13:56:56.839Z\u001b[39m \u001b[34mINFO \u001b[39m  Path 2: john_student -> student -> learner -> knowledgeable \r\n"]
[0.000045, "o", "\u001b[90m2025-10-04T13:56:56.839Z\u001b[39m \u001b[34mINFO \u001b[39m  Path 3: john_student -> student -> person -> agent -> goal_directed \r\n"]
[0.000469, "o", "\u001b[90m2025-10-04T13:56:56.840Z\u001b[39m \u001b[34mINFO \u001b[39m  \\nTotal tasks in system: 70 \r\n"]
[0.000037, "o", "\u001b[90m2025-10-04T13:56:56.840Z\u001b[39m \u001b[34mINFO \u001b[39m  Derived beliefs about John: 1 \r\n"]
[0.000032, "o", "\u001b[90m2025-10-04T13:56:56.840Z\u001b[39m \u001b[34mINFO \u001b[39m  \\nDerived conclusions about John: \r\n"]
[0.000123, "o", "\u001b[90m2025-10-04T13:56:56.840Z\u001b[39m \u001b[34mINFO \u001b[39m  \\nBackward chain inferences: 43 \r\n"]
[0.000028, "o", "\u001b[90m2025-10-04T13:56:56.840Z\u001b[39m \u001b[34mINFO \u001b[39m  \\nInference Rules Applied: \r\n"]
[0.000031, "o", "\u001b[90m2025-10-04T13:56:56.840Z\u001b[39m \u001b[34mINFO \u001b[39m  - Deduction: (A --> B), A |= B \r\n"]
[0.000029, "o", "\u001b[90m2025-10-04T13:56:56.840Z\u001b[39m \u001b[34mINFO \u001b[39m  - Induction: (A --> C), (B --> C) |= (A --> B) or (B --> A) \r\n"]
[0.000025, "o", "\u001b[90m2025-10-04T13:56:56.840Z\u001b[39m \u001b[34mINFO \u001b[39m  - Abduction: (A --> C), (B --> C) |= (A --> B) with different meaning \r\n"]
[0.000023, "o", "\u001b[90m2025-10-04T13:56:56.840Z\u001b[39m \u001b[34mINFO \u001b[39m  - Comparison: (A --> C), (B --> C) |= (A <-> B) \r\n"]
[0.000052, "o", "\r\n\u001b[1m\u001b[36m╔══════════════════════════════════════════════════════════════════════════════╗\u001b[0m\r\n"]
